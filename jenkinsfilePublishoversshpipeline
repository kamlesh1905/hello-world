pipeline {
    agent any

    tools {
        // Install the Maven version configured as "M3" and add it to the path.
        maven "maven"
    }

    stages {
        
        stage('Git Checkout'){
            steps{
                git 'https://github.com/kamlesh1905/hello-world.git'
            }
        }
        
        stage('Build') {
            steps {
               
                // Run Maven on a Unix agent.
                sh "mvn clean package"

                // To run Maven on a Windows agent, use
                // bat "mvn -Dmaven.test.failure.ignore=true clean package"
            }
        }
        stage('deploy'){
         steps{
              deploy adapters: [tomcat9(credentialsId: 'tomcat', path: '', url: 'http://13.233.77.218:8080/')], contextPath: 'webapp', war: '**/*.war'
          }
        }
        stage ('Sending artifact to Ansible over ssh') {
            steps{
            sshagent(['ansible']) {
            sh 'ssh -o StrictHostKeyChecking=no ec2-user@172.31.1.60'
            sh 'scp /var/lib/jenkins/workspace/GitMavenCopyWarFilePipeline/webapp/target/webapp.war ec2-user@172.31.1.60:/home/ec2-user'
        }
      } 
    }
    stage ('Sending artifact to dockerhost over ssh') {
            steps{
            sshagent(['docker']) {
            sh 'ssh -o StrictHostKeyChecking=no ec2-user@172.31.4.151'
            sh 'scp /var/lib/jenkins/workspace/GitMavenCopyWarFilePipeline/webapp/target/webapp.war ec2-user@172.31.4.151:/home/ec2-user'
        }
      } 
    }
    stage('Publish over SSH'){
        steps{
            sshPublisher(publishers: [sshPublisherDesc(configName: 'dockerhost', transfers: [sshTransfer(cleanRemote: false, excludes: '', execCommand: '''cd /opt/docker;
docker build -t regapp:v1 .;
docker stop regcont;
docker rm regcont;
docker run -d --name regcont -p 8080:8080 regapp:v1''', execTimeout: 120000, flatten: false, makeEmptyDirs: false, noDefaultExcludes: false, patternSeparator: '[, ]+', remoteDirectory: '//opt//docker', remoteDirectorySDF: false, removePrefix: 'webapp/target', sourceFiles: 'webapp/target/**/*.war')], usePromotionTimestamp: false, useWorkspaceInPromotion: false, verbose: false)])
        }
    }
    
  }
}
